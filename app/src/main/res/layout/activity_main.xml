<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:ignore="SpeakableTextPresentCheck" />

    <FrameLayout
        android:id="@+id/bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <io.legado.app.lib.theme.view.ThemeBottomNavigationVIew
            android:id="@+id/bottom_navigation_view"
            android:layout_width="304dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:itemActiveIndicatorStyle="@style/MiuixBottomNavIndicator"
            app:itemTextAppearanceActive="@style/MiuixBottomNavText"
            app:itemTextAppearanceInactive="@style/MiuixBottomNavText"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/main_bnv" />
    </FrameLayout>

</LinearLayout>